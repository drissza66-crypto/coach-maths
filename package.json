{
  "name": "mathsuivi-tuteur",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w @mathsuivi/api\" \"npm run dev -w @mathsuivi/web\"",
    "build": "npm run build -w @mathsuivi/web",
    "start": "npm run start -w @mathsuivi/api",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:generate": "npm run db:generate -w @mathsuivi/api",
    "db:seed": "npm run db:seed -w @mathsuivi/api",
    "eval:tutor": "npm run eval:tutor -w @mathsuivi/api"
  },
  "engines": {
    "node": ">=20.12"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "typescript": "^5.9.3"
  }
}
