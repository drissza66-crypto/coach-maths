# Copier ce fichier en .env puis adapter. Ne jamais versionner .env.

NODE_ENV=development
PORT=3001
APP_URL=http://localhost:5173

# ── Base de données ──────────────────────────────────────────────
# Vide : PostgreSQL embarqué (PGlite), aucune installation nécessaire.
# Production : DATABASE_URL=postgres://user:motdepasse@hote:5432/mathsuivi
DATABASE_URL=
PGLITE_DATA_DIR=./.data/pglite

# ── Authentification ─────────────────────────────────────────────
SESSION_TTL_DAYS=7
MAGIC_LINK_TTL_MINUTES=15
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
RATE_LIMIT_ENABLED=true
# Obligatoire à true en production (HTTPS).
COOKIE_SECURE=false
# Domaines e-mail autorisés à créer un compte formateur (séparés par des virgules).
FORMATEUR_ALLOWED_DOMAINS=cfa-demo.test

# ── E-mails ──────────────────────────────────────────────────────
# console : le lien de connexion s'affiche dans le terminal de l'API.
MAIL_TRANSPORT=console
# SMTP_URL=smtps://utilisateur:motdepasse@smtp.exemple.fr:465
MAIL_FROM=Coach Maths <no-reply@localhost>

# ── Fichiers importés (cours du formateur) ───────────────────────
# Dossier des fichiers chiffrés. Hors de OneDrive/Dropbox de préférence.
FILES_DIR=./.data/files
# Clé AES-256 en base64 (32 octets) : openssl rand -base64 32
# Obligatoire en production. Vide en développement : une clé locale est créée.
# ⚠️ Perdre la clé = perdre l'accès aux fichiers.
FILE_ENCRYPTION_KEY=
# Suppression automatique des cours importés.
FILE_RETENTION_DAYS=30
# Taille maximale d'un fichier envoyé (Mo).
UPLOAD_MAX_MB=10

# ── RGPD ─────────────────────────────────────────────────────────
# À changer quand le texte des règles ou de l'accord IA change.
CONSENT_VERSION=2026-10

# ── Fournisseur d'IA ─────────────────────────────────────────────
# Changer de fournisseur = modifier ces lignes, rien d'autre.
# mock | mistral | gemini | claude | openai-compatible
# mock : réponses de démonstration, aucune clé, aucune donnée envoyée.
LLM_PROVIDER=mock
# Nom exact du modèle chez le fournisseur choisi (voir README).
LLM_MODEL=
LLM_API_KEY=
# openai-compatible : adresse de l'API (Groq, OpenRouter, Ollama…). Facultatif ailleurs.
LLM_BASE_URL=
# Modèle pour lire les photos, si différent de LLM_MODEL.
LLM_VISION_MODEL=

# Repli facultatif si le fournisseur principal échoue (quota, panne, clé invalide).
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_MODEL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_VISION_MODEL=

LLM_TIMEOUT_MS=60000
# Réessais sur erreur passagère (429, 5xx), attente doublée à chaque fois.
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_MS=1000
# Au-delà de cette attente, on passe directement au repli.
LLM_RETRY_MAX_WAIT_MS=8000

# Messages au tuteur par apprenti et par jour (remis à zéro à minuit, heure de Paris).
DAILY_MESSAGE_LIMIT=40
# Durée de conservation du journal des appels et des compteurs de modération (sans contenu).
LLM_LOG_RETENTION_DAYS=90
# Conversations avec le tuteur effacées après ce nombre de jours sans activité.
CHAT_RETENTION_DAYS=30
# Nombre de messages précédents renvoyés à l'IA à chaque tour.
CHAT_HISTORY_MESSAGES=20

# Mode Mock : délai entre les mots du streaming, et panne simulée pour tester
# (rate_limit | quota | auth | timeout | unavailable | content_filter).
MOCK_DELAY_MS=15
MOCK_FAIL=
